        try:
            if getattr(self,"_android_activity",None):
                self._android_activity.unbind(on_activity_result=self._on_save_result)
            if intent is None:return
            data=self._module_abt_bytes(self.pending_save_module or self.current_module()); self._write_android_uri(intent.getData(),data); self.set_status("ABT сохранён")
        except Exception as e:self.set_status("Ошибка сохранения: "+str(e))
    def picker(self,title,save=False):
        root=BoxLayout(orientation="vertical"); fc=FileChooserListView(path=str(Path.home()),filters=["*.abt","*.ABT","*.txt"] if not save else []); root.add_widget(fc); buttons=BoxLayout(size_hint_y=None,height=dp(48)); ok=Button(text="Сохранить" if save else "Открыть"); cancel=Button(text="Отмена");buttons.add_widget(ok);buttons.add_widget(cancel);root.add_widget(buttons);pop=Popup(title=title,content=root,size_hint=(.96,.92));cancel.bind(on_release=pop.dismiss)
        if save:
            name=TextInput(text="IC.abt",multiline=False,size_hint_y=None,height=dp(44));root.add_widget(name,index=1);ok.bind(on_release=lambda *_:self.do_save(fc.path,name.text,pop))
        else: ok.bind(on_release=lambda *_:self.do_open(fc.selection,pop))
        pop.open()
    def open_picker(self,*_):self.picker("Открыть As-Built")
    def save_picker(self,*_):self.picker("Сохранить As-Built",True)
    def do_open(self,selection,pop):
        if not selection:return
        try:
            parsed=parse_abt(Path(selection[0]).read_text(encoding="utf-8-sig",errors="replace"),self.app.data["modules"])
            if not parsed:self.set_status("ABT строки не распознаны");return
            existing={(r.get("module"),r.get("address")):r for r in self.app.data["rows"]}
            for r in parsed:existing[(r["module"],r["address"])]=r
            self.app.data["rows"]=list(existing.values());self.changed={};self.changed_positions={};self.app.save_settings();pop.dismiss();self.refresh();self.set_status(f"Открыто строк: {len(parsed)}")
        except Exception as e:self.set_status(str(e))
    def current_module(self):
        if not self.tabs or not self.tabs.current_tab:return self.app.data["modules"][0]
        mid=self.tabs.current_tab.text;return next((m for m in self.app.data["modules"] if m["id"]==mid),self.app.data["modules"][0])
    def do_save(self,folder,name,pop):
        try:
            p=Path(folder)/(name if name.lower().endswith(".abt") else name+".abt"); p.write_bytes(self._module_abt_bytes(self.current_module()));pop.dismiss();self.set_status(f"Сохранено: {p.name}")
        except Exception as e:self.set_status("Ошибка сохранения: "+str(e))
    def admin_login(self,*_):
        box=BoxLayout(orientation="vertical",spacing=dp(7),padding=dp(10));u=TextInput(hint_text="Логин",multiline=False);p=TextInput(hint_text="Пароль",password=True,multiline=False);b=Button(text="Войти",size_hint_y=None,height=dp(48));box.add_widget(u);box.add_widget(p);box.add_widget(b);pop=Popup(title="Администратор",content=box,size_hint=(.9,.48))
        def go(*_):
            if u.text==self.app.data["username"] and hashlib.sha256(p.text.encode()).hexdigest()==self.app.data["password_hash"]:pop.dismiss();self.admin_panel()
            else:self.set_status("Неверный логин или пароль")
        b.bind(on_release=go);pop.open()
    def admin_panel(self):
        root=BoxLayout(orientation="vertical",spacing=dp(5),padding=dp(7)); tabs=TabbedPanel(do_default_tab=False)
        ui_tab=TabbedPanelItem(text="Оформление"); sv=ScrollView(); form=GridLayout(cols=1,spacing=dp(5),size_hint_y=None);form.bind(minimum_height=form.setter("height")); ui=self.app.data.get("ui",{})
        fields={}
        for key,label in [("title","Название приложения"),("author_text","Текст автора"),("link1_text","Текст ссылки 1"),("link1_url","URL ссылки 1"),("link2_text","Текст ссылки 2"),("link2_url","URL ссылки 2")]:
            form.add_widget(Label(text=label,size_hint_y=None,height=dp(24))); t=TextInput(text=ui.get(key,""),multiline=False,size_hint_y=None,height=dp(42)); fields[key]=t; form.add_widget(t)
        sv.add_widget(form);ui_tab.add_widget(sv);tabs.add_widget(ui_tab)
        ft=TabbedPanelItem(text="Функции"); fb=BoxLayout(orientation="vertical",spacing=dp(5)); selector=Spinner(text=(self.app.data["features"][0]["label"] if self.app.data["features"] else "Нет функций"),values=[x["label"] for x in self.app.data["features"]],size_hint_y=None,height=dp(44)); fb.add_widget(selector); editor=TextInput(font_name="RobotoMono");fb.add_widget(editor)
        def load_feature(*_):
            f=next((x for x in self.app.data["features"] if x["label"]==selector.text),{}); editor.text=json.dumps(f,ensure_ascii=False,indent=2)
        selector.bind(text=load_feature);load_feature();ft.add_widget(fb);tabs.add_widget(ft);root.add_widget(tabs)
        buttons=BoxLayout(size_hint_y=None,height=dp(50),spacing=dp(5));save=Button(text="Сохранить");close=Button(text="Закрыть");buttons.add_widget(save);buttons.add_widget(close);root.add_widget(buttons);pop=Popup(title="Админ-панель V2.4",content=root,size_hint=(.98,.96));close.bind(on_release=pop.dismiss)
        def apply(*_):
            try:
                for k,t in fields.items():self.app.data.setdefault("ui",{})[k]=t.text.strip()
                if self.app.data["features"] and editor.text.strip():
                    newf=json.loads(editor.text); idx=next(i for i,x in enumerate(self.app.data["features"]) if x["label"]==selector.text); self.app.data["features"][idx]=newf
                self.app.save_settings();self.refresh();self.set_status("Настройки сохранены")
            except Exception as e:self.set_status("Ошибка настроек: "+str(e))
        save.bind(on_release=apply);pop.open()

class MazdaAndroidApp(App):
    def build(self):
        self.title="Mazda 6 GH As-Built Studio V2.4"; Window.softinput_mode="below_target"; self.db=Path(self.user_data_dir)/"settings.json"; self.data=self.load_settings(); return Main()
    def load_settings(self):
        try:
            if self.db.exists():return json.loads(self.db.read_text(encoding="utf-8"))
        except:pass
        return json.loads(json.dumps(DEFAULT,ensure_ascii=False))
    def save_settings(self): self.db.parent.mkdir(parents=True,exist_ok=True);self.db.write_text(json.dumps(self.data,ensure_ascii=False,indent=2),encoding="utf-8")
if __name__=="__main__": MazdaAndroidApp().run()
